# Auto-detect text files and normalize line endings
* text=auto

# Specific file types
*.py text eol=lf
*.ipynb text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.cff text eol=lf
*.toml text eol=lf
*.sh text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.xlsx binary
*.parquet binary
*.pkl binary
*.joblib binary
*.h5 binary
*.pt binary

# Jupyter notebook diffs
*.ipynb diff=ipynb

# GitHub Linguist overrides
*.ipynb linguist-detectable=true
*.ipynb linguist-documentation=false