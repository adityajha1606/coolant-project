# ============================================================
#  Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.cache/

# ============================================================
#  Virtual environments
# ============================================================
.venv/
venv/
env/
ENV/
.python-version

# ============================================================
#  Jupyter
# ============================================================
.ipynb_checkpoints/
*.ipynb_checkpoints

# ============================================================
#  Data — large files
# ============================================================
# Processed data is regenerated from raw; exclude from git
data/processed/*.parquet
data/processed/*.csv

# Raw Excel dataset is ~2MB, small enough to commit
# data/raw/*.xlsx
# data/raw/*.csv

# ============================================================
#  Models — large binaries (>100MB hard limit on GitHub)
# ============================================================
# Model artifacts are regenerated by re-running notebooks
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.onnx
models/*.bin
models/*.safetensors

# Keep the JSON metadata files — they're small
!models/*.json

# ============================================================
#  OS
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================================
#  Editors / IDE
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.vim/

# ============================================================
#  Secrets & local config
# ============================================================
.env
.env.*
*.env
secrets.json
credentials.json

# ============================================================
#  Reports (generated PDFs / DOCX)
# ============================================================
# Uncomment if you don't want compiled reports in the repo
# reports/*.pdf
# reports/*.docx

# ============================================================
#  Misc
# ============================================================
*.log
*.tmp
*.bak
*.orig
*.rej